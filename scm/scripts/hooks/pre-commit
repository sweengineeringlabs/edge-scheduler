#!/usr/bin/env bash
set -euo pipefail

# Ensure ~/.cargo/bin is on PATH (git-bash on Windows omits it by default).
export PATH="$HOME/.cargo/bin:$PATH"

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCM_DIR="$REPO_ROOT/scm"
echo "pre-commit ── $(basename $REPO_ROOT) ──"
cd "$SCM_DIR"
echo "  1/4 fmt..."
cargo fmt --all -- --check
echo "  2/4 clippy..."
cargo clippy --workspace --all-targets -- -D warnings
# Exclude pre-existing SEA compliance violations (tracked in edge-scheduler backlog):
#   39,42 — README/CHANGELOG presence
#   50    — core pub(crate) visibility
#   66    — scripts/ci/ directory
#   124   — inline unit test coverage
#   126   — saf/ re-exports traits
#   160   — public types outside api/
#   218,221,222 — SAF factory / test coverage
#   228,232 — api/ type/trait completeness
echo "  3/4 arch audit..."
arch audit --rs -c "1-38,40-41,43-49,51-65,67-123,125,127-159,161-215,217,219,220,223-227,229-231,233-400"
echo "  4/4 cargo audit..."
cargo audit --deny unsound --deny yanked
echo "pre-commit: all checks passed."
